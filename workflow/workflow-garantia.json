    {
      "parameters": {
        "jsCode": "// Calcula a data final da garantia e decide qual ação tomar em cada linha.\n// data_compra deve estar no formato dd/mm/aaaa.\nconst hoje = new Date();\nhoje.setHours(0, 0, 0, 0);\nconst emailValido = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst saida = [];\n\n$input.all().forEach((item, index) => {\n  const r = item.json;\n  const email = String(r.email || '').trim();\n\n  // Regra: ignorar linhas sem e-mail válido ou sem data de compra\n  if (!emailValido.test(email) || !r.data_compra) return;\n  // Regra: garantias já marcadas como vencidas não geram nada\n  if (r.status === 'vencida') return;\n\n  const [d, m, a] = String(r.data_compra).split('/').map(Number);\n  if (!d || !m || !a) return;\n\n  const fim = new Date(a, m - 1 + Number(r.meses_garantia || 0), d);\n  const dias = Math.round((fim - hoje) / 86400000);\n\n  let acao = null;\n  if (dias < 0) acao = 'vencida';\n  else if (dias <= 7 && r.aviso_7 !== 'enviado') acao = 'aviso_7';\n  else if (dias <= 30 && dias > 7 && r.aviso_30 !== 'enviado') acao = 'aviso_30';\n  if (!acao) return;\n\n  saida.push({\n    json: {\n      ...r,\n      email,\n      acao,\n      dias_restantes: dias,\n      data_final: fim.toLocaleDateString('pt-BR'),\n      data_final_iso: fim.toISOString().slice(0, 10),\n    },\n    pairedItem: { item: index },\n  });\n});\n\nreturn saida;"
      },
      "name": "Calcular garantia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
